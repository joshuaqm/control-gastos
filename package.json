{
  "name": "control-gastos",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:frontend": "vite --host 0.0.0.0",
    "dev:backend": "nodemon --watch backend/src --exec \"ts-node -P backend/tsconfig.json backend/src/index.ts\"",
    "build": "vite build",
    "build:backend": "tsc -p backend/tsconfig.json",
    "preview": "vite preview",
    "test": "pnpm run test:backend && pnpm run test:frontend",
    "test:frontend": "vitest run",
    "test:backend": "vitest run --root backend",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p backend/tsconfig.json --noEmit",
    "format": "oxfmt",
    "seed": "cd backend && ts-node src/scripts/seed.ts",
    "typeorm": "cd backend && typeorm-ts-node-commonjs",
    "migration:run": "cd backend && typeorm-ts-node-commonjs migration:run -d src/config/database.ts",
    "migration:generate": "cd backend && typeorm-ts-node-commonjs migration:generate -d src/config/database.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.30.0",
    "node-cron": "^4.6.0",
    "openai": "^4.20.0",
    "pg": "^8.11.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.3.17",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.55.0",
    "jsdom": "^26.0.0",
    "nodemon": "^3.0.1",
    "oxfmt": "^0.2.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.0.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
