# ============================================================
# Control de Gastos - Backend
# Copia este archivo como `.env` para desarrollo local con Docker.
# En Vercel las variables se configuran en Project > Settings > Environment Variables.
# ============================================================

# --- Base de datos local (Docker Compose) ---
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_password
POSTGRES_DB=finance_db
DB_HOST=postgres
DB_PORT=5432

# --- Base de datos en produccion (Vercel + Supabase) ---
# Usa la URL "Connection string" del proyecto Supabase.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_SSL=true

# --- Aplicacion ---
NODE_ENV=development
PORT=8000
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d
OPENAI_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Activa el logging SQL de TypeORM (true/false)
TYPEORM_LOGGING=false
