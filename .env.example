# ============================================================
# Control de Gastos - Frontend
# Copia este archivo como `.env` para desarrollo local.
#
# Producción (Vercel): la API se sirve en el mismo dominio con
# `/api/v1`. Ese valor ya está fijo en `.env.production` y no
# hace falta configurarlo en Vercel, salvo que quieras apuntar
# a otro origen.
# ============================================================

# URL base de la API (sin barra final)
VITE_API_URL=http://localhost:8000/api/v1
